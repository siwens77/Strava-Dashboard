library(readxl)
Middle_East_aggregated_data_up_to_2026_02_28 <- read_excel("Documents/uni/data_vis/lab3/Middle-East_aggregated_data_up_to-2026-02-28.xlsx")
View(Middle_East_aggregated_data_up_to_2026_02_28)
library(readxl)
library(scales)
library(dplyr)
library(plotly)
library(scales)
library(tidyr)
library(ggplot2)
library(knitr)
library(arrow)
library(DT)
library(sf)
library(ggiraph)
library(patchwork)
library(readr)
library(tidyverse)
library(RColorBrewer)
library(WDI)
library(ggrepel)
library(tinytex)
fatalities<-read_excel("number_of_reported_fatalities_by_country-year_as-of-06Mar2026.xlsx")
fatalities_all<-fatalities %>% filter(YEAR>=1997, YEAR<=2025) %>%
complete(COUNTRY, YEAR=1997:2025)
fatalities_na<-fatalities_all %>% filter(is.na(FATALITIES))
fatalities_zero<-fatalities_all %>% filter(!is.na(FATALITIES), FATALITIES==0)
fatalities_positive<-fatalities_all %>% filter(!is.na(FATALITIES), FATALITIES>0)
max_fatalities <- max(fatalities_positive$FATALITIES, na.rm = TRUE)
map <- plot_ly() %>%
add_trace(
data = fatalities_na,
type = "choropleth",
locations = ~COUNTRY,
locationmode = "country names",
z = ~rep(1, nrow(fatalities_na)),
frame = ~YEAR,
text = ~paste0("<b>", COUNTRY, "</b>", "<br>Year: ", YEAR, "<br>Fatalities: no data"),
hoverinfo = "text",
colorscale = list(c(0, "#bdbdbd"), c(1, "#bdbdbd")),
showscale = FALSE,
marker = list(line = list(color = "white", width = 0.7))
) %>%
add_trace(
data = fatalities_zero,
type = "choropleth",
locations = ~COUNTRY,
locationmode = "country names",
z = ~rep(1, nrow(fatalities_zero)),
frame = ~YEAR,
text = ~paste0("<b>", COUNTRY, "</b>", "<br>Year: ", YEAR, "<br>Fatalities: 0"),
hoverinfo = "text",
colorscale = list(c(0, "#1a9850"), c(1, "#1a9850")),
showscale = FALSE,
marker = list(line = list(color = "white", width = 0.7))
) %>%
add_trace(
data = fatalities_positive,
type = "choropleth",
locations = ~COUNTRY,
locationmode = "country names",
z = ~FATALITIES,
frame = ~YEAR,
text = ~paste0("<b>", COUNTRY, "</b>", "<br>Year: ", YEAR, "<br>Fatalities: ", comma(FATALITIES)),
hoverinfo = "text",
coloraxis = "coloraxis",
marker = list(line = list(color = "white", width = 0.7))
) %>%
layout(
title = list(text = "<b>Reported Fatalities by Country</b>",
font = list(size = 24, color = "black"), x=0.5),
font = list(family = "Arial", size = 14, color = "black"),
margin = list(t = 90),
geo = list(
showframe = FALSE,
showcoastlines = TRUE,
coastlinecolor = "black",
projection = list(type = "natural earth")
),
coloraxis = list(
cmin = 0,
cmax = max_fatalities,
colorscale = list(
c(0, "#91cf60"),
c(0.01, "#d9ef8b"),
c(0.1, "#fee08b"),
c(0.5, "#fc8d59"),
c(1, "#d73027")
),
colorbar = list(
title = list(text = "Fatalities", side = "top"),
len = 0.75,
thickness = 40,
y = 0.7
)
)
) %>%
animation_opts(frame = 1000, transition = 500, redraw = TRUE) %>%
animation_slider(currentvalue = list(prefix = "Year: "))
map
world_sf <- read_sf("world.geojson") %>%
filter(!name %in% c("Antarctica", "Greenland")) %>%
mutate(unified_id = name)
df <- read_excel("Middle-East_aggregated_data_up_to-2026-02-28.xlsx")
events <- df %>%
group_by(COUNTRY) %>%
summarise(total_events = sum(EVENTS, na.rm = TRUE)) %>%
filter(total_events > max(total_events) / 1000) %>%
rename(unified_id = COUNTRY)
gdp <- read_csv("gdp.csv", skip = 4, show_col_types = FALSE) %>%
pivot_longer(any_of(as.character(2005:2020)), names_to = "Year", values_to = "GDP") %>%
mutate(Year = as.numeric(Year), unified_id = `Country Name`) %>%
filter(!is.na(GDP))
common_countries <- Reduce(intersect, list(gdp$unified_id, events$unified_id, world_sf$unified_id))
gdp    <- filter(gdp, unified_id %in% common_countries)
events <- filter(events, unified_id %in% common_countries)
country_colors <- setNames(
brewer.pal(6, "Paired"),
arrange(events, total_events)$unified_id
)
country_codes <- c("IQ", "LB", "IL", "JO", "SA", "KW")
events <- WDI(country = country_codes, indicator = "SP.POP.TOTL", start = 2022, end = 2022) %>%
rename(unified_id = country, population = SP.POP.TOTL) %>%
select(unified_id, population) %>%
right_join(events, by = "unified_id") %>%
mutate(events_per_100k = (total_events / population) * 100000)
map_data <- world_sf %>%
filter(unified_id %in% common_countries) %>%
left_join(events, by = "unified_id") %>%
mutate(total_events = replace_na(total_events, 0)) %>%
st_as_sf()
p1 <- ggplot(gdp, aes(Year, GDP, group = unified_id, color = unified_id)) +
geom_line_interactive(aes(data_id = unified_id, tooltip = unified_id), linewidth = 1) +
scale_color_manual(values = country_colors) +
scale_y_continuous(labels = label_number(scale = 1e-3, prefix = "$",suffix = "k")) +
labs(title = "GDP per Capita over time") +
theme_minimal() +
theme(
legend.position = "none",
plot.title    = element_text(face = "bold", size = 14),
plot.subtitle = element_text(size = 11, color = "gray40", margin = margin(b = 10)),
plot.margin   = margin(10, 15, 10, 20),
axis.title    = element_blank()
)
p2 <- ggplot(events, aes(reorder(unified_id, events_per_100k), events_per_100k,
fill = unified_id, tooltip = unified_id, data_id = unified_id)) +
geom_col_interactive() +
coord_flip() +
scale_fill_manual(values = country_colors, guide = "none") +
labs(title = "Conflict Fatality Rates (2014–2026)", y = "Fatalities per 100,000 residents") +
theme_minimal() +
theme(
axis.title.y     = element_blank(),
axis.title.x     = element_text(margin = margin(t = 13)),
panel.grid.major.y = element_blank(),
plot.title       = element_text(face = "bold", size = 14, hjust=0.5),
plot.margin      = margin(10, 20, 10, 10)
)
p3 <- ggplot() +
geom_sf(data = world_sf, fill = "lightgrey", color = "lightgrey", alpha = 0.4) +
geom_sf_interactive(data = filter(map_data, !is.na(total_events)),
aes(fill = unified_id, tooltip = unified_id, data_id = unified_id)) +
coord_sf(xlim = c(25, 65), ylim = c(15, 40), expand = FALSE) +
scale_fill_manual(values = country_colors, guide = "none") +
theme_void() +
theme(plot.margin = margin(10, 10, 20, 10))
girafe(code = print(p3 / (p2 + p1) + plot_layout(heights = c(2, 1)))) %>%
girafe_options(
opts_hover(css     = "filter: brightness(1.15); cursor: pointer; transition: all 0.5s ease-out;"),
opts_hover_inv(css = "opacity: 0.2;"),
opts_tooltip(css   = "border-radius: 12px; color: #333; background-color: white; padding: 10px; font-size: 14px; transition: all 0.5s ease-out;")
)
shiny::runApp('Documents/uni/data_vis/labs4/final')
shiny::runApp('Documents/uni/data_vis/labs4/final')
